{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "/opt/homebrew/bin/node",
      "runtimeArgs": ["scripts/dev-with-clean-env.mjs"],
      "port": 3000,
      "autoPort": false,
      "env": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
      }
    },
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "out", "-p", "3100", "-c-1", "--cors"],
      "port": 3100
    }
  ]
}
