# AB Entertainment Environment Variables
# Copy this file to .env.local and fill in the values

# ─── API Keys ───────────────────────────────────────────────
# OpenAI API Key (required for admin chatbot)
OPENAI_API_KEY=sk-your-key-here

# ─── Site Configuration ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://abentertainment.com.au

# ─── VPS API (for static export builds) ─────────────────────
# Required when NEXT_EXPORT=true — admin API calls route to this origin
NEXT_PUBLIC_VPS_API_URL=https://api.abentertainment.com.au

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://ab_admin:YOUR_PASSWORD@YOUR_VPS_IP:5432/abentertainment

# ─── Admin Authentication ────────────────────────────────────
# Username for admin portal login
ADMIN_USERNAME=your_admin_username

# Bcrypt hash of the admin password (work factor 12). Generate with:
#   node -e "const bcrypt=require('bcryptjs');bcrypt.hash('YOUR_PASSWORD',12).then(h=>console.log(h))"
# IMPORTANT: escape every $ as \$ in .env.local — Next.js (@next/env) runs dotenv-expand which
# strips unescaped $SEQUENCES, truncating the hash to 12 chars and causing login 401.
# Example (escaped): ADMIN_PASSWORD_HASH=\$2b\$12\$YXUHz...full...hash...chars
ADMIN_PASSWORD_HASH=change-me-use-bcrypt-hash

# Random 64-character hex string for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-use-random-hex-string

# Session version — increment to invalidate all active sessions
SESSION_VERSION=1

# ─── 2FA (Optional) ─────────────────────────────────────────
# TOTP secret for admin 2FA. Generate with:
#   node -e "const {generateSecret}=require('otplib');console.log(generateSecret())"
# TOTP_SECRET=

# ─── Escalation ─────────────────────────────────────────────
# Email shown in health dashboard for developer escalation
# NEXT_PUBLIC_ESCALATION_EMAIL=sarkar.vikram@gmail.com

# ─── Build Mode ──────────────────────────────────────────────
# Set to 'true' for static export (Hostinger shared hosting)
# Leave unset for Node.js server mode (VPS / Docker / Vercel)
# NEXT_EXPORT=true
