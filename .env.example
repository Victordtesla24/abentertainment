# AB Entertainment Environment Variables
# Copy this file to .env.local and fill in the values

# ─── API Keys ───────────────────────────────────────────────
# OpenAI API Key (required for chatbot)
OPENAI_API_KEY=sk-your-key-here

# ─── Site Configuration ─────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://abentertainment.com.au

# ─── Database ────────────────────────────────────────────────
DATABASE_URL=postgresql://ab_admin:secure_password@187.77.12.13:5432/abentertainment

# ─── Admin Authentication ────────────────────────────────────
# Username for admin portal login
ADMIN_USERNAME=admin

# SHA-256 hash of the admin password. Generate with:
#   node -e "const crypto=require('crypto');console.log(crypto.createHash('sha256').update('YOUR_PASSWORD').digest('hex'))"
ADMIN_PASSWORD_HASH=change-me-use-sha256-hash

# Random 64-character hex string for signing session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-use-random-hex-string
