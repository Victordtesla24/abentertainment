# AB Entertainment — Serve static export from out/ subdirectory
# Hostinger Git auto-deploy places the full repo at public_html root.
# This file transparently rewrites all requests to the out/ directory
# where the Next.js static export lives.

RewriteEngine On

# Skip rewriting for requests already in out/
RewriteCond %{REQUEST_URI} ^/out/ [NC]
RewriteRule ^ - [L]

# Skip rewriting for hidden files (.htaccess, .git, etc.)
RewriteRule ^\. - [L]

# If the file/directory exists in out/, rewrite transparently
RewriteCond %{DOCUMENT_ROOT}/out/$1 -f [OR]
RewriteCond %{DOCUMENT_ROOT}/out/$1 -d
RewriteRule ^(.*)$ out/$1 [L]

# Default: serve out/index.html for the root
RewriteCond %{REQUEST_URI} ^/$
RewriteRule ^$ out/index.html [L]

# Custom 404: serve the Next.js 404 page
ErrorDocument 404 /out/404.html

# Security: block access to source files
<FilesMatch "\.(tsx?|jsx?|json|mjs|lock|env|md|yml|yaml|mts|cts)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
  </IfModule>
</FilesMatch>

# Block access to source directories
RedirectMatch 403 ^/src(/.*)?$
RedirectMatch 403 ^/node_modules(/.*)?$
RedirectMatch 403 ^/\.git(/.*)?$
RedirectMatch 403 ^/data(/.*)?$
RedirectMatch 403 ^/scripts(/.*)?$
RedirectMatch 403 ^/docs(/.*)?$
RedirectMatch 403 ^/e2e(/.*)?$
RedirectMatch 403 ^/agent-system(/.*)?$
RedirectMatch 403 ^/\.claude(/.*)?$

# Cache static assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
